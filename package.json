{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:resume": "next build && node scripts/generate-resume-pdfs.mjs --out-dir out",
    "preview": "npm run build:resume && node scripts/static-server.mjs out 3000",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "puppeteer-core": "^25.3.0",
    "serve-handler": "^6.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.{css,json}": "biome format --write --no-errors-on-unmatched"
  }
}
